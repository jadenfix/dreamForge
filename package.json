{
  "name": "dreamforge",
  "version": "1.0.0",
  "description": "Production-grade VLM platform - From Prompt to Vision Models",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint pages components lib --ext .js,.jsx",
    "test": "jest",
    "test:watch": "jest --watch",
    "format": "prettier --write .",
    "clean": "rm -rf .next out dist",
    "test:tooling": "node --test tooling/tests/compatibility.cjs",
    "test:browser": "node tooling/browser/check.cjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.55.1",
    "dotenv": "^17.0.1",
    "lucide-react": "^0.292.0",
    "mongoose": "^8.0.0",
    "next": "15.5.27",
    "pino": "^8.16.0",
    "pino-pretty": "^10.2.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-dropzone": "^14.2.0",
    "react-hot-toast": "^2.4.0",
    "recharts": "^2.8.0",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@eslint/compat": "2.1.1",
    "@stylistic/eslint-plugin": "5.10.0",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^13.4.0",
    "@types/node": "^20.8.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "autoprefixer": "^10.4.0",
    "eslint": "10.12.0",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.5.0",
    "jest": "30.5.2",
    "jest-environment-jsdom": "30.5.2",
    "node-mocks-http": "^1.17.2",
    "playwright": "1.64.0",
    "postcss": "8.5.30",
    "prettier": "^3.0.0",
    "supertest": "^6.3.0",
    "tailwindcss": "4.3.3",
    "typescript": "^5.2.0"
  },
  "engines": {
    "node": "^22.17.0 || >=24.0.0"
  },
  "overrides": {
    "postcss": "$postcss",
    "postcss-selector-parser": "7.1.6",
    "@istanbuljs/load-nyc-config": {
      "js-yaml": "4.3.2"
    },
    "eslint-plugin-react": {
      "eslint": "$eslint"
    },
    "eslint-plugin-import": {
      "eslint": "$eslint"
    },
    "eslint-plugin-jsx-a11y": {
      "eslint": "$eslint"
    }
  }
}
